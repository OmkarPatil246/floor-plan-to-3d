# Python
__pycache__/
**/*__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Frontend dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/

# Virtual environments
.venv/
venv/
**/venv/
**/.venv/
ENV/
env/

# IDE / Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Data directory (keep directory and documentation tracked)
data/*
!data/README.md
!data/.gitkeep

# Checkpoints directory (keep directory tracked)
checkpoints/*
!checkpoints/README.md
!checkpoints/.gitkeep

# Training runs directory (keep directory tracked)
runs/*
!runs/README.md
!runs/.gitkeep

# Model weights directory (keep directories and READMEs tracked, ignore heavy weights)
weights/*
!weights/README.md
!weights/.gitkeep
!weights/recommendation_model/
weights/recommendation_model/*
!weights/recommendation_model/README.md
!weights/recommendation_model/.gitkeep

# Output images directory (keep directory tracked)
outputs/images/*
!outputs/images/.gitkeep
!outputs/images/README.md

# WandB & experiment caches
wandb/

# Machine learning model binaries (GitHub blocks files > 100MB)
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
*.h5
*.bin
*.incomplete

# Notebook outputs
.ipynb_checkpoints/
notebooks/scratch/

# Local env & secrets
.env
.env.local
.env.*.local
NOTES.local.md
.claude/settings.local.json
.wrangler/

# Logs and temporary files
*.log
*.tmp
Untitled-*.txt

# Media & recordings (source recordings, keep gifs/docs)
*.mp4

# Personal training infra
runpod_setup.sh
