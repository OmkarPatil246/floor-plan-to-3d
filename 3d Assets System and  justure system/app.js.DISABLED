import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';
import { HandGestureController } from './gestureController.js.DISABLED';

/**
 * Compact, sleek Selection Bounding Box with small Corner Resize Handles.
 */
class SleekCornerBoxHelper {
    constructor(scene) {
        this.scene = scene;
        this.target = null;
        this.group = new THREE.Group();
        this.group.name = 'SleekSelectionBoxGroup';

        // 12 Line edges
        const lineGeo = new THREE.BufferGeometry();
        const posArray = new Float32Array(12 * 2 * 3);
        lineGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
        this.lineMat = new THREE.LineBasicMaterial({
            color: 0x00f7ff,
            linewidth: 1.5,
            depthTest: false,
            transparent: true,
            opacity: 0.9
        });
        this.lines = new THREE.LineSegments(lineGeo, this.lineMat);
        this.lines.renderOrder = 998;
        this.group.add(this.lines);

        // 8 Small, sleek corner handles (compact 0.065m cubes)
        this.handles = [];
        this.handleGeo = new THREE.BoxGeometry(0.065, 0.065, 0.065);

        for (let i = 0; i < 8; i++) {
            const mat = new THREE.MeshBasicMaterial({
                color: 0x00f7ff,
                depthTest: false,
                transparent: true,
                opacity: 0.95
            });
            const handle = new THREE.Mesh(this.handleGeo, mat);
            handle.userData = { isCornerHandle: true, cornerIndex: i };
            handle.renderOrder = 999;
            this.handles.push(handle);
            this.group.add(handle);
        }

        this.group.visible = false;
        this.scene.add(this.group);

        this.box = new THREE.Box3();
        this.corners = [
            new THREE.Vector3(), new THREE.Vector3(), new THREE.Vector3(), new THREE.Vector3(),
            new THREE.Vector3(), new THREE.Vector3(), new THREE.Vector3(), new THREE.Vector3()
        ];
    }

    setFromObject(object) {
        if (!object) {
            this.target = null;
            this.group.visible = false;
            return;
        }
        this.target = object;
        this.update();
        this.group.visible = true;
    }

    update() {
        if (!this.target) return;
        this.box.setFromObject(this.target);

        const min = this.box.min;
        const max = this.box.max;

        this.corners[0].set(min.x, min.y, min.z);
        this.corners[1].set(max.x, min.y, min.z);
        this.corners[2].set(max.x, min.y, max.z);
        this.corners[3].set(min.x, min.y, max.z);
        this.corners[4].set(min.x, max.y, min.z);
        this.corners[5].set(max.x, max.y, min.z);
        this.corners[6].set(max.x, max.y, max.z);
        this.corners[7].set(min.x, max.y, max.z);

        for (let i = 0; i < 8; i++) {
            this.handles[i].position.copy(this.corners[i]);
        }

        const pos = this.lines.geometry.attributes.position.array;
        let idx = 0;
        const addLine = (c1, c2) => {
            pos[idx++] = c1.x; pos[idx++] = c1.y; pos[idx++] = c1.z;
            pos[idx++] = c2.x; pos[idx++] = c2.y; pos[idx++] = c2.z;
        };

        // Bottom edges
        addLine(this.corners[0], this.corners[1]);
        addLine(this.corners[1], this.corners[2]);
        addLine(this.corners[2], this.corners[3]);
        addLine(this.corners[3], this.corners[0]);

        // Top edges
        addLine(this.corners[4], this.corners[5]);
        addLine(this.corners[5], this.corners[6]);
        addLine(this.corners[6], this.corners[7]);
        addLine(this.corners[7], this.corners[4]);

        // Vertical edges
        addLine(this.corners[0], this.corners[4]);
        addLine(this.corners[1], this.corners[5]);
        addLine(this.corners[2], this.corners[6]);
        addLine(this.corners[3], this.corners[7]);

        this.lines.geometry.attributes.position.needsUpdate = true;
    }

    setHandleHighlight(index) {
        for (let i = 0; i < 8; i++) {
            const h = this.handles[i];
            if (i === index) {
                h.material.color.set(0xffff00);
                h.scale.set(1.25, 1.25, 1.25);
            } else {
                h.material.color.set(0x00f7ff);
                h.scale.set(1.0, 1.0, 1.0);
            }
        }
    }

    getHandleMeshes() {
        return this.handles;
    }

    hide() {
        this.target = null;
        this.group.visible = false;
        this.setHandleHighlight(-1);
    }
}

class FurnitureGameSystem {
    constructor() {
        this.scene = null;
        this.camera = null;
        this.renderer = null;
        this.orbitControls = null;

        // View Mode: 'FPS' (First Person View) or 'ORBIT'
        this.viewMode = 'FPS';

        // Player State
        this.playerPos = new THREE.Vector3(0, 1.7, 5);
        this.cameraYaw = 0;
        this.cameraPitch = 0;
        this.moveSpeed = 5.5;
        this.sprintSpeed = 10.0;
        this.keys = {
            forward: false,
            backward: false,
            left: false,
            right: false,
            sprint: false
        };
        this.isPointerLocked = false;
        this.isMouseDown = false;
        this.lastMouseX = 0;
        this.lastMouseY = 0;

        // Maximum Reach / Interaction Distance (12.0 meters — larger for orbit mode)
        this.MAX_REACH_DIST = 12.0;

        // Raycasting & Floor
        this.raycaster = new THREE.Raycaster();
        this.floorPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
        this.planeIntersectPoint = new THREE.Vector3();
        this.handFloorIntersection = new THREE.Vector3();
        this.isHandFloorValid = false;

        // Furniture State - By Default NO asset is selected!
        this.activeFurnitureIndex = -1;
        this.selectedObject = null;
        this.hoveredObject = null;
        this.hoveredHandle = null;

        // Explicit Drag & Drop State
        this.isDraggingFromHotbar = false;
        this.draggedHotbarIndex = -1;
        this.isDraggingExisting = false;
        this.draggedObject = null;
        this.isResizingCorner = false;
        this.activeCornerIndex = -1;
        this.dragOffset = new THREE.Vector3();
        this.resizeInitialScale = 1.0;
        this.resizeInitialDist = 1.0;
        this.resizeInitialCenter = new THREE.Vector3();

        // Two-hand transform initial baselines
        this.twoHandBaseScale = 1.0;
        this.twoHandBaseRotationY = 0;

        // Cursor tracking for accurate pinch position
        this.CURSOR_SELECTOR = '#hand-cursor-0';  // Cyan hand cursor (primary)
        this.cursorHistory = [];                   // recent cursor positions (for pre-pinch aiming)
        this._dbgT = null;                         // debug timeout

        this.placedObjects = [];
        this.furnitureModels = {};
        this.ghostPreviewMesh = null;
        this.idCounter = 1;
        this.cornerBoxHelper = null;

        this.lastFrameTime = performance.now();
        this._toastTimeout = null;
        this.gestureController = null;

        // Furniture Asset Catalog
        this.furnitureList = [
            { name: 'Gothic Commode', path: 'assets/GothicCommode_01_CC0', innerFolder: 'GothicCommode_01', icon: '🗄️' },
            { name: 'Lounge Chair', path: 'assets/mid_century_lounge_chair_CC0', innerFolder: 'mid_century_lounge_chair', icon: '🪑' },
            { name: 'Arm Chair', path: 'assets/modern_arm_chair_01_CC0', innerFolder: 'modern_arm_chair_01', icon: '🪑' },
            { name: 'Ottoman', path: 'assets/Ottoman_01_CC0', innerFolder: 'Ottoman_01', icon: '🛋️' },
            { name: 'Round Table', path: 'assets/round_wooden_table_01_CC0', innerFolder: 'round_wooden_table_01', icon: '⭕' },
            { name: 'Small Table', path: 'assets/small_wooden_table_01_CC0', innerFolder: 'small_wooden_table_01', icon: '📦' },
            { name: 'Sofa 1', path: 'assets/Sofa_01_CC0', innerFolder: 'Sofa_01', icon: '🛋️' },
            { name: 'Sofa 2', path: 'assets/sofa_02_CC0', innerFolder: 'sofa_02', icon: '🛋️' },
            { name: 'Sofa 3', path: 'assets/sofa_03_CC0', innerFolder: 'sofa_03', icon: '🛋️' },
            { name: 'Wooden Drawer', path: 'assets/vintage_wooden_drawer_01_CC0', innerFolder: 'vintage_wooden_drawer_01', icon: '🗄️' },
            { name: 'Wooden Table', path: 'assets/wooden_table_02_CC0', innerFolder: 'wooden_table_02', icon: '🪑' }
        ];

        this.init();
        this.setupEventListeners();
        // Load furniture models AFTER auto-clear
        this.loadAllFurniture();
    }

    init() {
        // Scene setup
        this.scene = new THREE.Scene();
        this.scene.background = new THREE.Color(0x121620);
        this.scene.fog = new THREE.FogExp2(0x121620, 0.015);

        // Perspective Camera
        const canvas = document.getElementById('canvas');
        this.camera = new THREE.PerspectiveCamera(
            70,
            window.innerWidth / window.innerHeight,
            0.1,
            500
        );
        this.updateCameraTransform();

        // WebGL Renderer
        this.renderer = new THREE.WebGLRenderer({
            canvas: canvas,
            antialias: true
        });
        this.renderer.setSize(window.innerWidth, window.innerHeight);
        this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        this.renderer.shadowMap.enabled = true;
        this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;

        // Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.85);
        this.scene.add(ambientLight);

        const sunLight = new THREE.DirectionalLight(0xfffaed, 1.2);
        sunLight.position.set(16, 26, 14);
        sunLight.castShadow = true;
        sunLight.shadow.camera.left = -30;
        sunLight.shadow.camera.right = 30;
        sunLight.shadow.camera.top = 30;
        sunLight.shadow.camera.bottom = -30;
        sunLight.shadow.camera.near = 0.5;
        sunLight.shadow.camera.far = 100;
        sunLight.shadow.mapSize.width = 2048;
        sunLight.shadow.mapSize.height = 2048;
        this.scene.add(sunLight);

        const hemiLight = new THREE.HemisphereLight(0x7fb3d5, 0x2c3e50, 0.45);
        this.scene.add(hemiLight);

        // Ground Floor Mesh (60m x 60m) - NO house model!
        const groundGeo = new THREE.PlaneGeometry(60, 60);
        const groundMat = new THREE.MeshStandardMaterial({
            color: 0x1e2430,
            roughness: 0.8,
            metalness: 0.2
        });
        this.ground = new THREE.Mesh(groundGeo, groundMat);
        this.ground.rotation.x = -Math.PI / 2;
        this.ground.receiveShadow = true;
        this.ground.name = 'floorPlaneMesh';
        this.scene.add(this.ground);

        // Visual Floor Grid
        const gridHelper = new THREE.GridHelper(60, 60, 0x00f7ff, 0x334155);
        gridHelper.position.y = 0.005;
        this.scene.add(gridHelper);

        // Sleek Corner Box Helper for selected furniture
        this.cornerBoxHelper = new SleekCornerBoxHelper(this.scene);

        // OrbitControls for TPP mode
        this.orbitControls = new OrbitControls(this.camera, this.renderer.domElement);
        this.orbitControls.enableDamping = true;
        this.orbitControls.dampingFactor = 0.06;
        this.orbitControls.maxPolarAngle = Math.PI / 2 - 0.02;
        this.orbitControls.minDistance = 2.5;
        this.orbitControls.maxDistance = 60;
        this.orbitControls.enabled = false;

        // Ghost Placement Preview Hologram - Hidden by default!
        const ghostBoxGeo = new THREE.BoxGeometry(1, 1, 1);
        const ghostBoxMat = new THREE.MeshBasicMaterial({
            color: 0x00f7ff,
            transparent: true,
            opacity: 0.4,
            wireframe: false
        });
        this.ghostPreviewMesh = new THREE.Mesh(ghostBoxGeo, ghostBoxMat);
        this.ghostPreviewMesh.visible = false;
        this.scene.add(this.ghostPreviewMesh);

        // Initialize Two-Hand Gesture Controller
        this.initGestureController();

        // ⚠️ AUTO-CLEAR: Remove any pre-placed objects on startup
        // This ensures the scene starts completely empty
        this.autoClearOnStartup();

        // Start render loop
        this.animate();
    }

    updateCameraTransform() {
        if (this.viewMode === 'FPS') {
            this.camera.position.copy(this.playerPos);

            const euler = new THREE.Euler(0, 0, 0, 'YXZ');
            euler.x = this.cameraPitch;
            euler.y = this.cameraYaw;
            this.camera.quaternion.setFromEuler(euler);
        }
    }

    toggleViewMode() {
        if (this.viewMode === 'FPS') {
            this.viewMode = 'ORBIT';
            this.orbitControls.enabled = true;
            this.orbitControls.target.set(this.playerPos.x, 0.5, this.playerPos.z);
            this.camera.position.set(this.playerPos.x + 8, 10, this.playerPos.z + 8);
            this.orbitControls.update();

            document.getElementById('view-mode-icon').textContent = '🌐';
            document.getElementById('view-mode-text').textContent = 'Orbit View (V)';
            document.getElementById('crosshair').style.display = 'none';
            document.getElementById('pointer-lock-prompt').style.display = 'none';
            this.showToast('Switched to Orbit View', 1000);
        } else {
            this.viewMode = 'FPS';
            this.orbitControls.enabled = false;
            this.updateCameraTransform();

            document.getElementById('view-mode-icon').textContent = '🚶';
            document.getElementById('view-mode-text').textContent = 'First Person (V)';
            document.getElementById('crosshair').style.display = 'block';
            document.getElementById('pointer-lock-prompt').style.display = 'block';
            this.showToast('Switched to First Person View', 1000);
        }
    }

    // =========================================================================
    // TWO-HAND GESTURE RECOGNITION & DRAG-AND-DROP
    // =========================================================================

    initGestureController() {
        this.gestureController = new HandGestureController();

        // 1. OPEN HAND / POINT -> MOVE CURSOR
        this.gestureController.onPointerMove = (pointer, ndc, gesture) => {
            this.handlePointerMove(pointer, ndc, gesture);
        };

        // 2. PINCH START -> SELECT / GRAB
        this.gestureController.onPinchStart = (ndc, data) => {
            this.handlePinchStart(ndc, data);
        };

        // 3. PINCH MOVE -> DRAG
        this.gestureController.onPinchMove = (ndc, data) => {
            this.handlePinchMove(ndc, data);
        };

        // 4. PINCH END -> DROP / PLACE
        this.gestureController.onPinchEnd = (ndc, data) => {
            this.handlePinchEnd(ndc, data);
        };

        // 5. TWO-HAND PINCH -> SCALE + ROTATE
        this.gestureController.onTwoHandTransform = (transform) => {
            this.handleTwoHandTransform(transform);
        };

        // 6. FIST -> CANCEL / DESELECT
        this.gestureController.onCancel = () => {
            this.handleGestureCancel();
        };

        // 7. PEACE SIGN (held 0.7s) -> DELETE selected object
        this.gestureController.onDeleteGesture = () => {
            if (this.selectedObject) {
                this.showToast(`\u274c Deleted: ${this.selectedObject.userData.furnitureType || 'Object'}`, 1200);
                this.deleteSelectedObject();
            } else {
                this.showToast('No object selected — pinch one first', 1200);
            }
        };

        // 8. THREE FINGERS (held 0.7s) -> DUPLICATE selected object
        this.gestureController.onDuplicateGesture = () => {
            if (this.selectedObject) {
                const dup = this.duplicateSelectedObject();
                if (dup) this.showToast(`\u{1F4CB} Duplicated: ${dup.userData.furnitureType || 'Object'}`, 1200);
            } else {
                this.showToast('No object selected — pinch one first', 1200);
            }
        };

        this.gestureController.start();
    }


    getPlacedObjectFromMesh(mesh) {
        let cur = mesh;
        while (cur) {
            if (this.placedObjects.includes(cur)) return cur;
            // Also check for house-environment objects tagged as selectable
            if (cur.userData && cur.userData.isSelectableEnvObj && this.placedObjects.includes(cur)) return cur;
            cur = cur.parent;
        }
        return null;
    }

    // Get the effective camera position regardless of view mode
    getEffectiveCameraPos() {
        if (this.viewMode === 'ORBIT') {
            return this.camera.position;
        }
        return this.playerPos;
    }

    // Single source of truth: the on-screen pointer position
    getScreenPos(pointer, data = null) {
        if (data && data.screenPos) return { x: data.screenPos.x, y: data.screenPos.y };
        return { x: pointer.x * window.innerWidth, y: pointer.y * window.innerHeight };
    }

    // Always derive NDC from the screen pointer, so the 3D ray matches the visible cursor exactly
    screenToNDC(x, y) {
        return new THREE.Vector2(
            (x / window.innerWidth) * 2 - 1,
            -(y / window.innerHeight) * 2 + 1
        );
    }

    // STRICT: only true if the pointer is really inside a slot (NO tolerance for 3D object priority)
    getHotbarSlotAt(screenX, screenY) {
        const slots = document.querySelectorAll('.hotbar-slot');
        for (const s of slots) {
            const r = s.getBoundingClientRect();
            // Must be strictly inside the slot bounds
            if (screenX >= r.left && screenX <= r.right &&
                screenY >= r.top && screenY <= r.bottom) {
                return s;
            }
        }
        return null;
    }

    // Pointer is over the hotbar panel itself (UI blocks 3D picking there)
    isOverHotbarPanel(screenX, screenY) {
        const panel = document.getElementById('hotbar-container') || document.getElementById('hotbar');
        if (!panel) return false;
        const r = panel.getBoundingClientRect();
        return screenX >= r.left && screenX <= r.right && screenY >= r.top && screenY <= r.bottom;
    }

    // Pick the placed model under the pointer (mesh hit first, then forgiving bounding-box fallback)
    // ndc must be a THREE.Vector2 or object with {x, y}
    pickPlacedObject(ndc) {
        const ndcVec = (ndc instanceof THREE.Vector2) ? ndc : new THREE.Vector2(ndc.x, ndc.y);
        this.raycaster.setFromCamera(ndcVec, this.camera);

        // Primary: mesh-level intersection (most accurate)
        const hits = this.raycaster.intersectObjects(this.placedObjects, true);
        for (const h of hits) {
            const root = this.getPlacedObjectFromMesh(h.object);
            if (root) return root;
        }

        // Fallback: expand bounding boxes generously for thin legs/edges & hand jitter
        let best = null, bestDist = Infinity;
        const box = new THREE.Box3();
        const point = new THREE.Vector3();
        for (const obj of this.placedObjects) {
            box.setFromObject(obj).expandByScalar(0.25); // 25cm generous margin
            if (this.raycaster.ray.intersectBox(box, point)) {
                const d = point.distanceTo(this.raycaster.ray.origin);
                if (d < bestDist) { bestDist = d; best = obj; }
            }
        }
        return best;
    }

    // Release the inventory selection (called when a placed model gets selected)
    releaseHotbarSelection() {
        this.isDraggingFromHotbar = false;
        this.draggedHotbarIndex = -1;
        if (this.activeFurnitureIndex !== -1) this.selectHotbarSlot(-1);
        if (this.ghostPreviewMesh) this.ghostPreviewMesh.visible = false;
    }

    // Real position of the pink circle (center of its DOM element), fallback to controller data
    getCursorScreenPos(pointer = null, data = null) {
        const el = document.querySelector(this.CURSOR_SELECTOR);
        if (el) {
            const r = el.getBoundingClientRect();
            if (r.width > 0 && r.height > 0) {
                return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
            }
        }
        if (pointer || data) return this.getScreenPos(pointer, data);
        return { x: window.innerWidth / 2, y: window.innerHeight / 2 };
    }

    recordCursor(x, y) {
        const now = performance.now();
        this.cursorHistory.push({ x, y, t: now });
        while (this.cursorHistory.length && now - this.cursorHistory[0].t > 500) {
            this.cursorHistory.shift();
        }
    }

    // Where the circle was ~120ms BEFORE the pinch (pinching makes the fingertip drift)
    getPrePinchPos(pointer, data) {
        const now = performance.now();
        for (let i = this.cursorHistory.length - 1; i >= 0; i--) {
            if (now - this.cursorHistory[i].t >= 120) {
                return { x: this.cursorHistory[i].x, y: this.cursorHistory[i].y };
            }
        }
        if (this.cursorHistory.length) {
            const f = this.cursorHistory[0];
            return { x: f.x, y: f.y };
        }
        return this.getCursorScreenPos(pointer, data);
    }

    // Green dot showing exactly where the pinch picked (remove when done testing)
    showPickDebug(x, y) {
        let dot = document.getElementById('pick-debug-dot');
        if (!dot) {
            dot = document.createElement('div');
            dot.id = 'pick-debug-dot';
            dot.style.cssText = 'position:fixed;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:#00ff66;border:2px solid #fff;z-index:99999;pointer-events:none;';
            document.body.appendChild(dot);
        }
        dot.style.left = x + 'px';
        dot.style.top = y + 'px';
        dot.style.display = 'block';
        clearTimeout(this._dbgT);
        this._dbgT = setTimeout(() => dot.style.display = 'none', 500);
    }

    isOverDustbin(screenX, screenY) {
        const bin = document.getElementById('dustbin-container');
        if (!bin) return false;
        const rect = bin.getBoundingClientRect();
        // Generous hit-box with 25px margin for effortless dropping
        return (
            screenX >= rect.left - 25 &&
            screenX <= rect.right + 25 &&
            screenY >= rect.top - 25 &&
            screenY <= rect.bottom + 25
        );
    }

    triggerDustbinSuccessAnimation() {
        const bin = document.getElementById('dustbin-container');
        if (!bin) return;
        bin.classList.remove('dustbin-crunch', 'drag-over', 'drag-active');
        void bin.offsetWidth; // Force CSS reflow
        bin.classList.add('dustbin-crunch');
        setTimeout(() => bin.classList.remove('dustbin-crunch'), 600);
    }

    // 1. Open hand: Cursor follows index fingertip / palm position
    handlePointerMove(pointer, ndc, hoveredElem) {
        const { x: screenX, y: screenY } = this.getCursorScreenPos(pointer);
        this.recordCursor(screenX, screenY);
        const ndcCalc = this.screenToNDC(screenX, screenY);

        // Dustbin hover state update during drag
        const binEl = document.getElementById('dustbin-container');
        if (binEl) {
            if (this.isDraggingExisting || this.isDraggingFromHotbar) {
                binEl.classList.add('drag-active');
                if (this.isOverDustbin(screenX, screenY)) {
                    binEl.classList.add('drag-over');
                    if (this.ghostPreviewMesh) this.ghostPreviewMesh.visible = false;
                    this.hoveredHandle = null;
                    this.hoveredObject = null;
                    this.isHandFloorValid = false;
                    if (this.gestureController) {
                        this.gestureController.updateStatus('🗑️ Over Trash Bin', 'Release pinch to DELETE object', 'status-error');
                    }
                    return;
                } else {
                    binEl.classList.remove('drag-over');
                }
            } else {
                binEl.classList.remove('drag-active', 'drag-over');
            }
        }

        // ========================================================================
        // PRIORITY A: CORNER HANDLES (if object is selected and in reach)
        // ========================================================================
        this.raycaster.setFromCamera(ndcCalc, this.camera);
        const camPos = this.getEffectiveCameraPos();
        if (this.selectedObject && this.cornerBoxHelper) {
            const distToSel = camPos.distanceTo(this.selectedObject.position);
            if (distToSel <= this.MAX_REACH_DIST) {
                const handleHits = this.raycaster.intersectObjects(this.cornerBoxHelper.getHandleMeshes(), false);
                if (handleHits.length > 0) {
                    const handle = handleHits[0].object;
                    this.hoveredHandle = handle;
                    this.cornerBoxHelper.setHandleHighlight(handle.userData.cornerIndex);
                    this.hoveredObject = null;
                    // Clear hotbar hover when over 3D content
                    document.querySelectorAll('.hotbar-slot.gesture-hover').forEach(s => s.classList.remove('gesture-hover'));
                    return;
                }
            }
            this.hoveredHandle = null;
            this.cornerBoxHelper.setHandleHighlight(-1);
        }

        // ========================================================================
        // PRIORITY B: PLACED FURNITURE (3D objects take priority over UI!)
        // ========================================================================
        const rootObj = this.pickPlacedObject(ndcCalc);
        if (rootObj && camPos.distanceTo(rootObj.position) <= this.MAX_REACH_DIST) {
            this.hoveredObject = rootObj;
            // Clear hotbar hover when hovering over 3D object
            document.querySelectorAll('.hotbar-slot.gesture-hover').forEach(s => s.classList.remove('gesture-hover'));
            return;
        }
        this.hoveredObject = null;

        // ========================================================================
        // PRIORITY C: HOTBAR SLOT (Only when NOT over a 3D object)
        // ========================================================================
        const slot = this.getHotbarSlotAt(screenX, screenY);
        document.querySelectorAll('.hotbar-slot.gesture-hover').forEach(s => {
            if (s !== slot) s.classList.remove('gesture-hover');
        });

        if (slot) {
            slot.classList.add('gesture-hover');
            this.isHandFloorValid = false;
            return;
        }

        if (this.isOverHotbarPanel(screenX, screenY)) {
            this.isHandFloorValid = false;
            return;
        }

        // ========================================================================
        // PRIORITY D: FLOOR PLANE (for ghost preview when dragging from hotbar)
        // ========================================================================
        this.raycaster.setFromCamera(ndcCalc, this.camera);
        if (this.raycaster.ray.intersectPlane(this.floorPlane, this.planeIntersectPoint)) {
            const dist = this.playerPos.distanceTo(this.planeIntersectPoint);
            // Valid only within reach distance
            if (dist <= this.MAX_REACH_DIST) {
                this.isHandFloorValid = true;
                this.handFloorIntersection.copy(this.planeIntersectPoint);

                // Update ghost preview if currently dragging from hotbar
                if (this.isDraggingFromHotbar && this.ghostPreviewMesh) {
                    this.ghostPreviewMesh.position.set(
                        this.planeIntersectPoint.x,
                        this.ghostPreviewMesh.geometry.parameters.height / 2,
                        this.planeIntersectPoint.z
                    );
                    this.ghostPreviewMesh.rotation.y = this.cameraYaw;
                    this.ghostPreviewMesh.visible = true;
                }
                return;
            }
        }

        this.isHandFloorValid = false;
        if (this.isDraggingFromHotbar && this.ghostPreviewMesh) {
            this.ghostPreviewMesh.visible = false;
        }
    }

    // Helper: build a set of sample pick-points around pre-pinch and live positions
    // Casts a 28px ring around each point to forgive fingertip drift
    getPickPoints(pointer, data) {
        const pre  = this.getPrePinchPos(pointer, data);
        const live = this.getCursorScreenPos(pointer, data);
        const pts  = [pre, live];
        const r = 28; // px ring radius
        for (const b of [pre, live]) {
            pts.push(
                { x: b.x + r, y: b.y },
                { x: b.x - r, y: b.y },
                { x: b.x, y: b.y + r },
                { x: b.x, y: b.y - r }
            );
        }
        return { pre, live, pts };
    }

    // 2. Pinch Start - PRIORITY: Corner → Placed Object → Hotbar (strict) → Deselect
    handlePinchStart(ndcFromController, data) {
        const { pre, live, pts } = this.getPickPoints(data.pointer, data);
        this.showPickDebug(pre.x, pre.y);
        this.pinchStartScreen = { x: pre.x, y: pre.y };
        const camPos = this.getEffectiveCameraPos();

        // ========================================================================
        // PRIORITY 1: CORNER HANDLE (screen-space, if object already selected)
        // ========================================================================
        if (this.selectedObject && this.cornerBoxHelper &&
            camPos.distanceTo(this.selectedObject.position) <= this.MAX_REACH_DIST) {
            for (const p of [pre, live]) {
                this.raycaster.setFromCamera(this.screenToNDC(p.x, p.y), this.camera);
                const hits = this.raycaster.intersectObjects(this.cornerBoxHelper.getHandleMeshes(), false);
                if (hits.length > 0) {
                    this.isResizingCorner   = true;
                    this.activeCornerIndex  = hits[0].object.userData.cornerIndex;
                    this.cornerBoxHelper.setHandleHighlight(this.activeCornerIndex);

                    // Screen-space baseline: project object centre into screen pixels
                    const ctr = new THREE.Box3()
                        .setFromObject(this.selectedObject)
                        .getCenter(new THREE.Vector3())
                        .project(this.camera);
                    this.resizeCenterScreen = {
                        x: (ctr.x + 1) / 2 * window.innerWidth,
                        y: (1 - ctr.y) / 2 * window.innerHeight,
                    };
                    this.resizeStartDist   = Math.max(40, Math.hypot(
                        p.x - this.resizeCenterScreen.x,
                        p.y - this.resizeCenterScreen.y
                    ));
                    this.resizeInitialScale = this.selectedObject.scale.x;

                    this.showToast('🔧 Pull corner to resize', 1000);
                    return;
                }
            }
        }

        // ========================================================================
        // PRIORITY 2: PLACED OBJECT — try many points to beat fingertip drift
        // ========================================================================
        let rootObj = null, hitPos = pre;
        for (const p of pts) {
            rootObj = this.pickPlacedObject(this.screenToNDC(p.x, p.y));
            if (rootObj) { hitPos = p; break; }
        }

        if (rootObj) {
            if (camPos.distanceTo(rootObj.position) > this.MAX_REACH_DIST) {
                this.showToast('⚠️ Too far — walk closer (WASD) or use Orbit View (V)', 1800);
                return;
            }
            this.selectObject(rootObj);
            this.isDraggingExisting = true;
            this.draggedObject      = rootObj;

            this.raycaster.setFromCamera(this.screenToNDC(hitPos.x, hitPos.y), this.camera);
            if (this.raycaster.ray.intersectPlane(this.floorPlane, this.planeIntersectPoint)) {
                this.dragOffset.set(
                    rootObj.position.x - this.planeIntersectPoint.x,
                    0,
                    rootObj.position.z - this.planeIntersectPoint.z
                );
            } else {
                this.dragOffset.set(0, 0, 0);
            }
            this.showToast(`✋ Grabbed: ${rootObj.userData.furnitureType || 'Object'} • Drag to move`, 1200);
            return;
        }

        // ========================================================================
        // PRIORITY 3: HOTBAR SLOT — STRICT: both pre-pinch AND live must hit the same slot
        // ========================================================================
        const s1 = this.getHotbarSlotAt(pre.x,  pre.y);
        const s2 = this.getHotbarSlotAt(live.x, live.y);
        if (s1 && s1 === s2 && s1.dataset.index !== undefined) {
            const idx = parseInt(s1.dataset.index);
            this.deselectObject();
            this.selectHotbarSlot(idx);
            this.isDraggingFromHotbar = true;
            this.draggedHotbarIndex   = idx;
            this.showToast(`📦 ${this.furnitureList[idx].name} • Drag to floor to place`, 1400);
            return;
        }

        // Pointer between hotbar slots -> ignore
        if (this.isOverHotbarPanel(live.x, live.y)) return;

        // ========================================================================
        // PRIORITY 4: EMPTY SPACE -> Deselect
        // ========================================================================
        if (this.selectedObject) {
            this.deselectObject();
            this.showToast('Deselected', 700);
        }
    }

    // 3. Pinch Move
    handlePinchMove(ndcFromController, data) {
        const { x, y } = this.getCursorScreenPos(data.pointer, data);
        this.recordCursor(x, y);

        // Show dustbin highlight while dragging anything
        const binEl = document.getElementById('dustbin-container');
        if (binEl && (this.isDraggingExisting || this.isDraggingFromHotbar)) {
            binEl.classList.add('drag-active');
            if (this.isOverDustbin(x, y)) {
                binEl.classList.add('drag-over');
                if (this.gestureController) {
                    this.gestureController.updateStatus('🗑️ Release to DELETE', 'Open pinch to drop into trash', 'status-error');
                }
            } else {
                binEl.classList.remove('drag-over');
            }
        }

        // ── A. CORNER RESIZE (screen-space — no floor-plane needed) ──────────
        if (this.isResizingCorner && this.selectedObject && this.resizeCenterScreen) {
            const d = Math.hypot(x - this.resizeCenterScreen.x, y - this.resizeCenterScreen.y);
            let s = this.resizeInitialScale * (d / this.resizeStartDist);
            s = Math.round(THREE.MathUtils.clamp(s, 0.2, 5.0) * 20) / 20; // 0.05 steps
            this.selectedObject.scale.set(s, s, s);
            this.updateYOffsetForObject(this.selectedObject);
            this.cornerBoxHelper.update();
            this.cornerBoxHelper.setHandleHighlight(this.activeCornerIndex);
            this.updateObjectData(this.selectedObject);
            return;
        }

        const ndc = this.screenToNDC(x, y);
        this.raycaster.setFromCamera(ndc, this.camera);
        if (this.raycaster.ray.intersectPlane(this.floorPlane, this.planeIntersectPoint)) {
            const camPos = this.getEffectiveCameraPos();
            const dist = camPos.distanceTo(this.planeIntersectPoint);

            // B. Dragging existing placed furniture (clamp to reach distance)
            if (this.isDraggingExisting && this.draggedObject) {
                if (dist <= this.MAX_REACH_DIST + 3.0) {
                    this.draggedObject.position.x = this.planeIntersectPoint.x + this.dragOffset.x;
                    this.draggedObject.position.z = this.planeIntersectPoint.z + this.dragOffset.z;
                    this.cornerBoxHelper.update();
                    this.updateObjectData(this.draggedObject);
                }
                return;
            }

            // C. Dragging ghost placement preview from hotbar
            if (this.isDraggingFromHotbar && this.ghostPreviewMesh) {
                if (dist <= this.MAX_REACH_DIST + 2.0) {
                    this.ghostPreviewMesh.position.x = this.planeIntersectPoint.x;
                    this.ghostPreviewMesh.position.z = this.planeIntersectPoint.z;
                    this.ghostPreviewMesh.visible = true;
                } else {
                    this.ghostPreviewMesh.visible = false;
                }
                return;
            }
        }
    }

    // 4. Pinch End: Drop / Place ONLY on explicit release of drag
    handlePinchEnd(ndcFromController, data) {
        const { x: screenX, y: screenY } = this.getCursorScreenPos(data.pointer, data);
        const ndc = this.screenToNDC(screenX, screenY);

        const binEl = document.getElementById('dustbin-container');
        if (binEl) {
            binEl.classList.remove('drag-active', 'drag-over');
        }

        // A. TRASH BASKET DROP: Drop object here to DELETE!
        if (this.isOverDustbin(screenX, screenY)) {
            if (this.isDraggingExisting && this.draggedObject) {
                const doomedObj = this.draggedObject;
                this.isDraggingExisting = false;
                this.draggedObject = null;
                this.deleteSelectedObject(doomedObj);
                this.triggerDustbinSuccessAnimation();
                return;
            }
            if (this.isDraggingFromHotbar) {
                this.isDraggingFromHotbar = false;
                this.draggedHotbarIndex = -1;
                if (this.ghostPreviewMesh) this.ghostPreviewMesh.visible = false;
                this.triggerDustbinSuccessAnimation();
                this.showToast('🗑️ Placement canceled & discarded', 1200);
                return;
            }
        }

        // B. Finish corner resize
        if (this.isResizingCorner && this.selectedObject) {
            this.isResizingCorner = false;
            this.activeCornerIndex = -1;
            this.cornerBoxHelper.setHandleHighlight(-1);
            this.showToast(`📐 Resized: ${this.selectedObject.scale.x.toFixed(1)}x`, 1200);
            return;
        }

        // C. Finish dragging existing furniture
        if (this.isDraggingExisting && this.draggedObject) {
            this.isDraggingExisting = false;
            const name = this.draggedObject.userData.furnitureType;
            this.showToast(`Placed ${name}`, 1200);
            this.updateObjectData(this.draggedObject);
            this.draggedObject = null;
            return;
        }

        // D. Drop / Place furniture from hotbar onto floor!
        if (this.isDraggingFromHotbar) {
            this.isDraggingFromHotbar = false;
            if (this.ghostPreviewMesh) this.ghostPreviewMesh.visible = false;

            this.raycaster.setFromCamera(ndc, this.camera);
            if (this.raycaster.ray.intersectPlane(this.floorPlane, this.planeIntersectPoint)) {
                const dist = this.playerPos.distanceTo(this.planeIntersectPoint);
                if (dist <= this.MAX_REACH_DIST) {
                    const spawned = this.placeFurnitureAtLocation(this.planeIntersectPoint.x, this.planeIntersectPoint.z, this.draggedHotbarIndex);
                    if (spawned) {
                        this.selectObject(spawned);
                        this.showToast(`Dropped & Placed: ${spawned.userData.furnitureType}!`, 1600);
                    }
                } else {
                    this.showToast('Too far away - walk closer (WASD)', 1400);
                }
            }
            this.draggedHotbarIndex = -1;
            return;
        }
    }

    // 5. Two-hand pinch: Scale + Rotate
    handleTwoHandTransform({ scaleMultiplier, deltaAngle }) {
        const camPos = this.getEffectiveCameraPos();

        if (!this.selectedObject) {
            // Auto-select the nearest placed object
            if (this.placedObjects.length > 0) {
                let nearest = null, nearestDist = Infinity;
                for (const obj of this.placedObjects) {
                    const d = camPos.distanceTo(obj.position);
                    if (d < nearestDist && d <= this.MAX_REACH_DIST) {
                        nearestDist = d;
                        nearest = obj;
                    }
                }
                if (nearest) this.selectObject(nearest);
                else return;
            } else {
                return;
            }
        }

        // Refresh baselines at the start of each two-hand gesture (gap > 250ms means new gesture)
        const t = performance.now();
        if (t - (this._lastTwoHandT || 0) > 250) {
            this.twoHandBaseScale      = this.selectedObject.scale.x || 1.0;
            this.twoHandBaseRotationY  = this.selectedObject.rotation.y;
        }
        this._lastTwoHandT = t;

        // Scale: clamp 0.2x – 5x in 0.05 steps
        let newScale = THREE.MathUtils.clamp(this.twoHandBaseScale * scaleMultiplier, 0.2, 5.0);
        newScale = Math.round(newScale * 20) / 20;
        this.selectedObject.scale.set(newScale, newScale, newScale);
        this.updateYOffsetForObject(this.selectedObject);

        // Rotate: 1.6x sensitivity
        this.selectedObject.rotation.y = this.twoHandBaseRotationY + (deltaAngle * 1.6);

        this.cornerBoxHelper.update();
        this.updateObjectData(this.selectedObject);
    }

    // 6. Closed fist: Cancel
    handleGestureCancel() {
        const binEl = document.getElementById('dustbin-container');
        if (binEl) binEl.classList.remove('drag-active', 'drag-over');

        if (this.isResizingCorner && this.selectedObject) {
            this.selectedObject.scale.set(this.resizeInitialScale, this.resizeInitialScale, this.resizeInitialScale);
            this.updateYOffsetForObject(this.selectedObject);
            this.cornerBoxHelper.update();
            this.isResizingCorner = false;
            this.activeCornerIndex = -1;
            this.showToast('✊ Canceled Resize', 1000);
            return;
        }

        if (this.isDraggingExisting) {
            this.isDraggingExisting = false;
            this.draggedObject = null;
            this.showToast('✊ Canceled Move', 1000);
            return;
        }

        if (this.isDraggingFromHotbar) {
            this.isDraggingFromHotbar = false;
            this.draggedHotbarIndex = -1;
            if (this.ghostPreviewMesh) this.ghostPreviewMesh.visible = false;
            this.showToast('✊ Canceled Placement', 1000);
            return;
        }

        if (this.selectedObject) {
            this.deselectObject();
            this.showToast('✊ Deselected', 1000);
        }
    }

    // =========================================================================
    // MINECRAFT HOTBAR & ASSET MANAGEMENT
    // =========================================================================

    createHotbar() {
        const hotbar = document.getElementById('hotbar');
        if (!hotbar) return;
        hotbar.innerHTML = '';

        this.furnitureList.forEach((item, index) => {
            const slot = document.createElement('div');
            // By default, NO slot is active!
            slot.className = `hotbar-slot ${index === this.activeFurnitureIndex ? 'active' : ''}`;
            slot.dataset.index = index;

            // Slot number 1-9
            const numberLabel = document.createElement('span');
            numberLabel.className = 'slot-number';
            numberLabel.textContent = `${index + 1}`;

            // Emoji / Icon
            const icon = document.createElement('div');
            icon.className = 'slot-icon';
            icon.textContent = item.icon;

            // Name label
            const label = document.createElement('span');
            label.className = 'slot-label';
            label.textContent = item.name.split(' ')[0];

            slot.appendChild(numberLabel);
            slot.appendChild(icon);
            slot.appendChild(label);

            // Direct mouse click / touch selection
            const onSelectSlot = (e) => {
                if (!e.isTrusted) return;   // NEW: ignore events dispatched by the gesture controller
                e.stopPropagation();
                this.selectHotbarSlot(index);
                this.isDraggingFromHotbar = true;
                this.draggedHotbarIndex = index;
                this.deselectObject();
                this.showToast(`Selected ${item.name} • Drag to floor`, 1000);
            };
            slot.addEventListener('pointerdown', onSelectSlot);
            slot.addEventListener('click', onSelectSlot);

            hotbar.appendChild(slot);
        });

        this.updateHotbarTooltip();
    }

    selectHotbarSlot(index) {
        this.activeFurnitureIndex = index;

        document.querySelectorAll('.hotbar-slot').forEach((slot, i) => {
            if (i === index) slot.classList.add('active');
            else slot.classList.remove('active');
        });

        this.updateHotbarTooltip();
        this.updateGhostPreviewMesh();
    }

    updateHotbarTooltip() {
        const tooltip = document.getElementById('hotbar-item-tooltip');
        if (!tooltip) return;

        if (this.activeFurnitureIndex === -1) {
            tooltip.innerHTML = `Pinch an asset below to select & drag onto floor`;
        } else {
            const item = this.furnitureList[this.activeFurnitureIndex];
            tooltip.innerHTML = `Holding: <span class="highlight">${item.name}</span> • Drag onto floor & release to drop`;
        }
    }

    updateGhostPreviewMesh() {
        if (this.activeFurnitureIndex === -1) {
            if (this.ghostPreviewMesh) this.ghostPreviewMesh.visible = false;
            return;
        }
        const item = this.furnitureList[this.activeFurnitureIndex];
        const model = this.furnitureModels[item.name];
        if (!model) return;

        const box = new THREE.Box3().setFromObject(model);
        const size = box.getSize(new THREE.Vector3());
        this.ghostPreviewMesh.geometry.dispose();
        this.ghostPreviewMesh.geometry = new THREE.BoxGeometry(size.x, size.y, size.z);
    }

    placeFurnitureAtLocation(x, z, overrideIndex = -1) {
        const targetIdx = overrideIndex !== -1 ? overrideIndex : this.activeFurnitureIndex;
        if (targetIdx === -1) return null;

        const item = this.furnitureList[targetIdx];
        const model = this.furnitureModels[item.name];
        if (!model) {
            this.showToast(`Loading ${item.name}...`, 1000);
            return null;
        }

        const clampedX = Math.max(-27, Math.min(27, x));
        const clampedZ = Math.max(-27, Math.min(27, z));

        const clone = model.clone(true);
        const box = new THREE.Box3().setFromObject(clone);
        const yOffset = -box.min.y;

        clone.position.set(clampedX, yOffset, clampedZ);
        clone.rotation.y = this.cameraYaw;

        clone.traverse((child) => {
            if (child.isMesh) {
                child.castShadow = true;
                child.receiveShadow = true;
            }
        });

        const uniqueId = `furniture_${item.name.toLowerCase().replace(/\s+/g, '_')}_${this.idCounter++}`;
        clone.userData = {
            id: uniqueId,
            furnitureType: item.name,
            yOffset: yOffset
        };

        this.scene.add(clone);
        this.placedObjects.push(clone);

        return clone;
    }

    updateYOffsetForObject(object) {
        const baseBox = new THREE.Box3().setFromObject(object);
        const yOffset = -baseBox.min.y + object.position.y;
        object.userData.yOffset = yOffset;
        object.position.y = yOffset;
    }

    // =========================================================================
    // SELECTION & EDITING
    // =========================================================================

    selectObject(object) {
        if (!object) return;
        this.releaseHotbarSelection();   // release hotbar slot highlight
        this.selectedObject = object;

        if (this.cornerBoxHelper) {
            this.cornerBoxHelper.setFromObject(object);
        }

        // Always update baselines when selecting
        this.twoHandBaseScale = object.scale.x > 0 ? object.scale.x : 1.0;
        this.twoHandBaseRotationY = object.rotation.y;

        const panel = document.getElementById('control-panel');
        if (panel) {
            panel.classList.add('visible');
            const nameEl = document.getElementById('selected-obj-name');
            if (nameEl) nameEl.textContent = object.userData.furnitureType || 'Object';
            const rotY = document.getElementById('rotation-y');
            const rotVal = document.getElementById('rotation-value');
            if (rotY && rotVal) {
                const deg = Math.round(THREE.MathUtils.radToDeg(object.rotation.y)) % 360;
                rotY.value = deg < 0 ? deg + 360 : deg;
                rotVal.textContent = `${rotY.value}°`;
            }
            const scaleSlider = document.getElementById('scale-slider');
            const scaleVal = document.getElementById('scale-value');
            if (scaleSlider && scaleVal) {
                scaleSlider.value = object.scale.x;
                scaleVal.textContent = object.scale.x.toFixed(1);
            }
        }
    }

    deselectObject() {
        this.selectedObject = null;
        if (this.cornerBoxHelper) this.cornerBoxHelper.hide();
        const panel = document.getElementById('control-panel');
        if (panel) panel.classList.remove('visible');
    }

    clearCurrentAsset() {
        console.log('🚫 Clearing current asset...');
        console.log('Before clear - activeFurnitureIndex:', this.activeFurnitureIndex);
        console.log('Before clear - isDraggingFromHotbar:', this.isDraggingFromHotbar);
        console.log('Before clear - ghost visible:', this.ghostPreviewMesh?.visible);
        
        // First, hide and reset ghost preview completely
        if (this.ghostPreviewMesh) {
            this.ghostPreviewMesh.visible = false;
            // Move ghost far away to ensure it's not visible
            this.ghostPreviewMesh.position.set(0, -1000, 0);
        }
        
        // Clear all drag states
        this.isDraggingFromHotbar = false;
        this.draggedHotbarIndex = -1;
        this.hasPlacedThisDrag = false;
        
        // Reset hand floor validation
        this.isHandFloorValid = false;
        
        // Update hotbar UI and clear selection (this will also set activeFurnitureIndex to -1)
        this.selectHotbarSlot(-1);
        
        console.log('After clear - activeFurnitureIndex:', this.activeFurnitureIndex);
        console.log('After clear - isDraggingFromHotbar:', this.isDraggingFromHotbar);
        console.log('After clear - ghost visible:', this.ghostPreviewMesh?.visible);
        console.log('After clear - ghost position:', this.ghostPreviewMesh?.position);
        
        this.showToast('🚫 Asset Cleared', 800);
    }

    clearAllPlacedObjects() {
        const count = this.placedObjects.length;
        
        if (count === 0) {
            this.showToast('⚠️ No objects to clear - scene is already empty', 1200);
            return;
        }
        
        console.log(`🧹 Starting to clear ${count} placed objects...`);
        
        // 1. Deselect any selected object first
        this.deselectObject();
        
        // 2. Cancel any ongoing drag operations
        this.isDraggingFromHotbar = false;
        this.isDraggingExisting = false;
        this.draggedObject = null;
        this.draggedHotbarIndex = -1;
        this.isResizingCorner = false;
        this.activeCornerIndex = -1;
        
        // 3. Hide ghost preview
        if (this.ghostPreviewMesh) {
            this.ghostPreviewMesh.visible = false;
        }
        
        // 4. Clear hotbar selection
        this.selectHotbarSlot(-1);
        
        // 5. Remove all placed objects from scene and dispose geometry/materials
        this.placedObjects.forEach(obj => {
            // Recursively dispose of all meshes, geometries, and materials
            obj.traverse((child) => {
                if (child.isMesh) {
                    if (child.geometry) {
                        child.geometry.dispose();
                    }
                    if (child.material) {
                        if (Array.isArray(child.material)) {
                            child.material.forEach(mat => mat.dispose());
                        } else {
                            child.material.dispose();
                        }
                    }
                }
            });
            // Remove from scene
            this.scene.remove(obj);
        });
        
        // 6. Clear the placed objects array
        this.placedObjects = [];
        
        // 7. Reset hovered states
        this.hoveredObject = null;
        this.hoveredHandle = null;
        
        // 8. Clear any localStorage or sessionStorage (if any exists)
        try {
            localStorage.removeItem('placedFurniture');
            localStorage.removeItem('furnitureState');
            sessionStorage.removeItem('placedFurniture');
            sessionStorage.removeItem('furnitureState');
        } catch (e) {
            // Ignore if storage doesn't exist
        }
        
        // 9. Reset ID counter for clean slate
        this.idCounter = 1;
        
        // 10. Hide corner box helper
        if (this.cornerBoxHelper) {
            this.cornerBoxHelper.hide();
        }
        
        // 11. Update control panel
        const controlPanel = document.getElementById('control-panel');
        if (controlPanel) {
            controlPanel.classList.remove('visible');
        }
        
        console.log(`✅ Successfully cleared ${count} objects from scene`);
        console.log('📊 Scene state:', {
            placedObjects: this.placedObjects.length,
            sceneChildren: this.scene.children.length,
            selectedObject: this.selectedObject,
            isDragging: this.isDraggingExisting || this.isDraggingFromHotbar
        });
        
        this.showToast(`🧹 Cleared ${count} object${count > 1 ? 's' : ''} • Scene is now empty`, 1500);
    }

    autoClearOnStartup() {
        console.log('🚀 AUTO-CLEAR ON STARTUP: Removing ALL pre-placed objects...');
        console.log('📊 Scene before clear:', this.scene.children.length, 'children');
        
        // AGGRESSIVE CLEAR: Remove EVERYTHING except these specific names/types
        const essentialNames = [
            'floorPlaneMesh',           // Ground floor
            'SleekSelectionBoxGroup'    // Corner box helper
        ];
        
        const objectsToRemove = [];
        const keptObjects = [];
        
        // Scan all scene children
        this.scene.children.forEach((child) => {
            // Keep ONLY these specific types/names
            const isLight = child.isLight || child.type.includes('Light');
            const isCamera = child.isCamera || child.type === 'Camera' || child.type === 'PerspectiveCamera';
            const isHelper = child.type === 'GridHelper';
            const isGhost = child === this.ghostPreviewMesh;
            const isCornerBox = child === this.cornerBoxHelper?.group;
            const isEssentialMesh = essentialNames.includes(child.name);
            
            if (isLight || isCamera || isHelper || isGhost || isCornerBox || isEssentialMesh) {
                keptObjects.push({
                    type: child.type,
                    name: child.name || '(unnamed)'
                });
                console.log('  ✅ KEEP:', child.type, child.name || '(unnamed)');
            } else {
                // REMOVE EVERYTHING ELSE
                objectsToRemove.push(child);
                console.log('  ❌ REMOVE:', child.type, child.name || '(unnamed)', 
                           'Children:', child.children?.length || 0);
            }
        });
        
        console.log(`\n🗑️ Removing ${objectsToRemove.length} objects...`);
        
        // Remove all marked objects
        objectsToRemove.forEach(obj => {
            // Deep disposal - traverse all children
            obj.traverse((child) => {
                if (child.isMesh) {
                    // Dispose geometry
                    if (child.geometry) {
                        child.geometry.dispose();
                        console.log('    🔧 Disposed geometry:', child.geometry.type);
                    }
                    // Dispose materials
                    if (child.material) {
                        if (Array.isArray(child.material)) {
                            child.material.forEach(mat => {
                                mat.dispose();
                                console.log('    🎨 Disposed material:', mat.type);
                            });
                        } else {
                            child.material.dispose();
                            console.log('    🎨 Disposed material:', child.material.type);
                        }
                    }
                }
            });
            
            // Remove from scene
            this.scene.remove(obj);
        });
        
        // FORCE CLEAR: Ensure placedObjects array is completely empty
        this.placedObjects = [];
        
        // Clear any storage
        try {
            localStorage.clear(); // Clear EVERYTHING
            sessionStorage.clear(); // Clear EVERYTHING
            console.log('  🧹 Cleared all localStorage and sessionStorage');
        } catch (e) {
            console.log('  ⚠️ Could not clear storage:', e.message);
        }
        
        // Reset ALL states to default
        this.selectedObject = null;
        this.hoveredObject = null;
        this.hoveredHandle = null;
        this.isDraggingFromHotbar = false;
        this.isDraggingExisting = false;
        this.draggedObject = null;
        this.draggedHotbarIndex = -1;
        this.isResizingCorner = false;
        this.activeCornerIndex = -1;
        this.activeFurnitureIndex = -1;
        this.primaryPinching = false;
        this.isTwoHandPinching = false;
        this.isHandFloorValid = false;
        
        // Hide all UI elements
        if (this.ghostPreviewMesh) {
            this.ghostPreviewMesh.visible = false;
        }
        if (this.cornerBoxHelper) {
            this.cornerBoxHelper.hide();
        }
        
        // Reset ID counter
        this.idCounter = 1;
        
        // Clear hotbar selection
        document.querySelectorAll('.hotbar-slot').forEach(slot => {
            slot.classList.remove('active', 'gesture-hover');
        });
        
        console.log('\n✅ AUTO-CLEAR COMPLETE!');
        console.log('📊 Scene after clear:', this.scene.children.length, 'children');
        console.log('📦 Placed objects:', this.placedObjects.length);
        console.log('🎯 Kept objects:', keptObjects.length);
        console.log('═══════════════════════════════════════════════════════');
        console.log('✨ Scene is now EMPTY and ready for fresh placement! ✨');
        console.log('═══════════════════════════════════════════════════════\n');
    }

    deleteSelectedObject(target = null) {
        const objToDelete = target || this.selectedObject;
        if (!objToDelete) return;
        const index = this.placedObjects.indexOf(objToDelete);
        if (index > -1) {
            this.placedObjects.splice(index, 1);
        }
        this.scene.remove(objToDelete);
        if (this.selectedObject === objToDelete) {
            this.deselectObject();
        }
        const name = objToDelete.userData?.furnitureType || 'Object';
        this.showToast(`🗑️ Deleted: ${name}`, 1200);
    }

    duplicateSelectedObject() {
        if (!this.selectedObject) return null;
        const itemType = this.selectedObject.userData.furnitureType;
        const model = this.furnitureModels[itemType];
        if (!model) return null;

        const clone = model.clone(true);
        clone.position.copy(this.selectedObject.position);
        clone.position.x += 1.2;
        clone.position.z += 1.2;
        clone.rotation.copy(this.selectedObject.rotation);
        clone.scale.copy(this.selectedObject.scale);

        clone.traverse((child) => {
            if (child.isMesh) {
                child.castShadow = true;
                child.receiveShadow = true;
            }
        });

        clone.userData = {
            id: `furniture_${itemType.toLowerCase().replace(/\s+/g, '_')}_${this.idCounter++}`,
            furnitureType: itemType,
            yOffset: this.selectedObject.userData.yOffset,
        };

        this.scene.add(clone);
        this.placedObjects.push(clone);
        this.selectObject(clone);
        this.showToast('📋 Duplicated', 1000);
        return clone;  // FIX: gesture toast needs the return value
    }

    rotateSelectedObject(degrees = 90) {
        if (!this.selectedObject) return;
        this.selectedObject.rotation.y = (this.selectedObject.rotation.y + THREE.MathUtils.degToRad(degrees)) % (Math.PI * 2);
        this.cornerBoxHelper.update();
        this.updateObjectData(this.selectedObject);
    }

    updateObjectData(object) {
        if (!object) return;
        if (this.cornerBoxHelper) this.cornerBoxHelper.update();

        const rotY = document.getElementById('rotation-y');
        const rotVal = document.getElementById('rotation-value');
        if (rotY && rotVal) {
            const deg = Math.round(THREE.MathUtils.radToDeg(object.rotation.y)) % 360;
            rotY.value = deg < 0 ? deg + 360 : deg;
            rotVal.textContent = `${rotY.value}°`;
        }

        const scaleSlider = document.getElementById('scale-slider');
        const scaleVal = document.getElementById('scale-value');
        if (scaleSlider && scaleVal) {
            scaleSlider.value = object.scale.x;
            scaleVal.textContent = object.scale.x.toFixed(1);
        }
    }

    // =========================================================================
    // MODEL & ASSET LOADERS (NO House Model)
    // =========================================================================

    async loadAllFurniture() {
        const loader = new GLTFLoader();
        const dracoLoader = new DRACOLoader();
        dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.6/');
        loader.setDRACOLoader(dracoLoader);

        const loadingEl = document.getElementById('loading');
        let loaded = 0;

        for (const item of this.furnitureList) {
            try {
                const glbPath = `${item.path}/${item.innerFolder}/${item.innerFolder}.glb`;
                const gltf = await new Promise((resolve, reject) => {
                    loader.load(glbPath, resolve, undefined, reject);
                });
                this.furnitureModels[item.name] = gltf.scene;
                loaded++;
            } catch (e) {
                console.warn(`Could not load ${item.name}`, e);
            }
        }

        if (loadingEl) loadingEl.style.display = 'none';

        this.createHotbar();
        console.log(`✅ Loaded ${loaded}/${this.furnitureList.length} 3D furniture models`);
    }

    // =========================================================================
    // EVENT LISTENERS & INPUT CONTROLS
    // =========================================================================

    setupEventListeners() {
        const canvas = this.renderer.domElement;

        // Window resize
        window.addEventListener('resize', () => {
            this.camera.aspect = window.innerWidth / window.innerHeight;
            this.camera.updateProjectionMatrix();
            this.renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // Pointer Lock & Mouse Look
        const promptEl = document.getElementById('pointer-lock-prompt');
        if (promptEl) {
            promptEl.addEventListener('click', () => {
                canvas.requestPointerLock();
            });
        }

        canvas.addEventListener('click', (e) => {
            const mouseNDC = new THREE.Vector2(
                (e.clientX / window.innerWidth) * 2 - 1,
                -(e.clientY / window.innerHeight) * 2 + 1
            );
            this.raycaster.setFromCamera(mouseNDC, this.camera);
            const camPos = this.getEffectiveCameraPos();

            // 1. Check corner handle hits if selected (don't deselect when clicking handles)
            if (this.selectedObject && this.cornerBoxHelper) {
                const distToSel = camPos.distanceTo(this.selectedObject.position);
                if (distToSel <= this.MAX_REACH_DIST) {
                    const handleHits = this.raycaster.intersectObjects(this.cornerBoxHelper.getHandleMeshes(), false);
                    if (handleHits.length > 0) {
                        return; // clicking a corner handle — don't deselect
                    }
                }
            }

            // 2. Check furniture hits (generous bounding-box pick too)
            const rootObjClick = this.pickPlacedObject(mouseNDC);
            if (rootObjClick) {
                const dist = camPos.distanceTo(rootObjClick.position);
                if (dist <= this.MAX_REACH_DIST) {
                    this.selectObject(rootObjClick);
                    this.showToast(`Selected: ${rootObjClick.userData.furnitureType || 'Object'}`, 900);
                    return;
                } else {
                    this.showToast('Too far away — walk closer (WASD) or switch to Orbit View (V)', 1400);
                    return;
                }
            }

            // 3. If dragging or holding hotbar item, place on floor
            if (this.isDraggingFromHotbar || this.activeFurnitureIndex !== -1) {
                if (this.raycaster.ray.intersectPlane(this.floorPlane, this.planeIntersectPoint)) {
                    const dist = camPos.distanceTo(this.planeIntersectPoint);
                    if (dist <= this.MAX_REACH_DIST) {
                        const targetIdx = this.draggedHotbarIndex !== -1 ? this.draggedHotbarIndex : this.activeFurnitureIndex;
                        const spawned = this.placeFurnitureAtLocation(this.planeIntersectPoint.x, this.planeIntersectPoint.z, targetIdx);
                        if (spawned) {
                            this.selectObject(spawned);
                            this.isDraggingFromHotbar = false;
                            this.showToast(`✅ Placed: ${spawned.userData.furnitureType}!`, 1200);
                            return;
                        }
                    } else {
                        this.showToast('Too far away — walk closer (WASD)', 1200);
                        return;
                    }
                }
            }

            // 4. Clicked empty space -> deselect or lock pointer
            if (this.selectedObject) {
                this.deselectObject();
            } else if (this.viewMode === 'FPS' && !this.isPointerLocked) {
                canvas.requestPointerLock();
            }
        });

        document.addEventListener('pointerlockchange', () => {
            this.isPointerLocked = (document.pointerLockElement === canvas);
            if (promptEl) {
                promptEl.style.display = this.isPointerLocked ? 'none' : 'block';
            }
        });

        // Dustbin Basket Click / Drop Event
        const dustbinEl = document.getElementById('dustbin-container');
        if (dustbinEl) {
            dustbinEl.addEventListener('click', (e) => {
                e.stopPropagation();
                if (this.selectedObject) {
                    const doomed = this.selectedObject;
                    this.deleteSelectedObject(doomed);
                    this.triggerDustbinSuccessAnimation();
                } else if (this.isDraggingFromHotbar || this.activeFurnitureIndex !== -1) {
                    this.isDraggingFromHotbar = false;
                    this.activeFurnitureIndex = -1;
                    this.selectHotbarSlot(-1);
                    this.triggerDustbinSuccessAnimation();
                    this.showToast('🗑️ Cleared selection', 1000);
                } else {
                    this.showToast('🗑️ Drag & drop any object here to delete', 1500);
                }
            });

            dustbinEl.addEventListener('pointerenter', () => {
                if (this.isDraggingExisting || this.isDraggingFromHotbar) {
                    dustbinEl.classList.add('drag-over');
                }
            });

            dustbinEl.addEventListener('pointerleave', () => {
                dustbinEl.classList.remove('drag-over');
            });
        }

        // Mouse Drag / Look
        window.addEventListener('mousedown', (e) => {
            if (e.target.closest('#hotbar-container') || e.target.closest('#dustbin-container') || e.target.closest('#game-top-bar') || e.target.closest('#gesture-pip-container') || e.target.closest('#control-panel')) {
                return;
            }
            this.isMouseDown = true;
            this.lastMouseX = e.clientX;
            this.lastMouseY = e.clientY;
        });

        window.addEventListener('mouseup', (e) => {
            this.isMouseDown = false;
            if (this.isOverDustbin(e.clientX, e.clientY)) {
                if (this.isDraggingExisting && this.draggedObject) {
                    const doomed = this.draggedObject;
                    this.isDraggingExisting = false;
                    this.draggedObject = null;
                    this.deleteSelectedObject(doomed);
                    this.triggerDustbinSuccessAnimation();
                    return;
                }
                if (this.isDraggingFromHotbar) {
                    this.isDraggingFromHotbar = false;
                    this.draggedHotbarIndex = -1;
                    if (this.ghostPreviewMesh) this.ghostPreviewMesh.visible = false;
                    this.triggerDustbinSuccessAnimation();
                    this.showToast('🗑️ Placement canceled & discarded', 1200);
                    return;
                }
            }
        });

        window.addEventListener('mousemove', (e) => {
            if (this.viewMode === 'FPS') {
                const sensitivity = 0.0022;

                if (this.isPointerLocked) {
                    this.cameraYaw -= e.movementX * sensitivity;
                    this.cameraPitch -= e.movementY * sensitivity;
                    this.cameraPitch = Math.max(-1.45, Math.min(1.45, this.cameraPitch));
                    this.updateCameraTransform();
                } else if (this.isMouseDown) {
                    const dx = e.clientX - this.lastMouseX;
                    const dy = e.clientY - this.lastMouseY;
                    this.lastMouseX = e.clientX;
                    this.lastMouseY = e.clientY;

                    this.cameraYaw -= dx * sensitivity * 1.5;
                    this.cameraPitch -= dy * sensitivity * 1.5;
                    this.cameraPitch = Math.max(-1.45, Math.min(1.45, this.cameraPitch));
                    this.updateCameraTransform();
                }
            }
        });

        // Keyboard Controls: WASD Walking, V for view mode
        window.addEventListener('keydown', (e) => {
            if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;

            // WASD Walking
            if (e.code === 'KeyW') this.keys.forward = true;
            if (e.code === 'KeyS') this.keys.backward = true;
            if (e.code === 'KeyA') this.keys.left = true;
            if (e.code === 'KeyD') this.keys.right = true;
            if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') this.keys.sprint = true;

            // Hotbar Keys: 1 through 9
            if (e.key >= '1' && e.key <= '9') {
                const slotIdx = parseInt(e.key) - 1;
                this.selectHotbarSlot(slotIdx);
            }

            // V: Toggle View Mode (First Person / Orbit)
            if (e.code === 'KeyV') {
                this.toggleViewMode();
            }

            // DEL: Delete selected
            if (e.code === 'Delete' || e.code === 'Backspace') {
                this.deleteSelectedObject();
            }
            
            // Ctrl+Shift+Delete: Clear ALL objects (with confirmation)
            if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.code === 'Delete' || e.code === 'Backspace')) {
                e.preventDefault();
                console.log('🎹 Ctrl+Shift+Delete pressed - triggering clear all');
                const count = this.placedObjects.length;
                if (count > 0) {
                    const confirmed = confirm(
                        `⚠️ CLEAR ALL ${count} OBJECTS?\n\n` +
                        `This will permanently delete everything from the scene.\n\n` +
                        `Click OK to clear all, or Cancel to keep your objects.`
                    );
                    if (confirmed) {
                        this.clearAllPlacedObjects();
                    }
                } else {
                    this.clearAllPlacedObjects();
                }
            }

            // ESC: Deselect object AND clear asset
            if (e.code === 'Escape') {
                console.log('🎹 ESC key pressed - deselecting and clearing');
                this.deselectObject();
                this.clearCurrentAsset();
            }

            // C: Clear current asset selection
            if (e.code === 'KeyC') {
                console.log('🎹 C key pressed - clearing asset');
                this.clearCurrentAsset();
            }
        });

        window.addEventListener('keyup', (e) => {
            if (e.code === 'KeyW') this.keys.forward = false;
            if (e.code === 'KeyS') this.keys.backward = false;
            if (e.code === 'KeyA') this.keys.left = false;
            if (e.code === 'KeyD') this.keys.right = false;
            if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') this.keys.sprint = false;
        });

        // Top Bar Buttons
        document.getElementById('view-mode-toggle')?.addEventListener('click', () => this.toggleViewMode());
        document.getElementById('clear-all-btn')?.addEventListener('click', () => {
            console.log('🧹 Clear All button clicked');
            
            // Show confirmation if there are objects
            const count = this.placedObjects.length;
            if (count > 0) {
                const confirmed = confirm(
                    `⚠️ CLEAR ALL OBJECTS?\n\n` +
                    `This will permanently delete all ${count} placed object${count > 1 ? 's' : ''} from the scene.\n\n` +
                    `This action cannot be undone.\n\n` +
                    `Click OK to clear, or Cancel to keep your objects.`
                );
                
                if (confirmed) {
                    console.log('✅ User confirmed - clearing all objects');
                    this.clearAllPlacedObjects();
                } else {
                    console.log('❌ User cancelled clear operation');
                    this.showToast('❌ Clear cancelled', 1000);
                }
            } else {
                // No objects, just call the function (it will show "already empty" message)
                this.clearAllPlacedObjects();
            }
        });

        // Hotbar Clear Button
        document.getElementById('clear-asset-btn')?.addEventListener('click', () => {
            console.log('🖱️ Clear button clicked');
            this.clearCurrentAsset();
        });

        // Control Panel Buttons
        document.getElementById('delete-btn')?.addEventListener('click', () => this.deleteSelectedObject());
        document.getElementById('duplicate-btn')?.addEventListener('click', () => this.duplicateSelectedObject());
        document.getElementById('rotate-90-btn')?.addEventListener('click', () => this.rotateSelectedObject(90));

        // Control Panel Sliders
        const rotSlider = document.getElementById('rotation-y');
        if (rotSlider) {
            rotSlider.addEventListener('input', (e) => {
                if (this.selectedObject) {
                    const deg = parseFloat(e.target.value);
                    this.selectedObject.rotation.y = THREE.MathUtils.degToRad(deg);
                    document.getElementById('rotation-value').textContent = `${deg}°`;
                    this.updateObjectData(this.selectedObject);
                }
            });
        }

        const scaleSlider = document.getElementById('scale-slider');
        if (scaleSlider) {
            scaleSlider.addEventListener('input', (e) => {
                if (this.selectedObject) {
                    const s = parseFloat(e.target.value);
                    this.selectedObject.scale.set(s, s, s);
                    this.updateYOffsetForObject(this.selectedObject);
                    document.getElementById('scale-value').textContent = s.toFixed(1);
                    this.updateObjectData(this.selectedObject);
                }
            });
        }

        // Mouse-wheel resize: scroll up = bigger, scroll down = smaller
        window.addEventListener('wheel', (e) => {
            if (!this.selectedObject) return;
            let s = this.selectedObject.scale.x * (e.deltaY < 0 ? 1.05 : 0.95);
            s = THREE.MathUtils.clamp(s, 0.2, 5);
            this.selectedObject.scale.set(s, s, s);
            this.updateYOffsetForObject(this.selectedObject);
            this.cornerBoxHelper?.update();
            this.updateObjectData(this.selectedObject);
        }, { passive: true });
    }

    // =========================================================================
    // GAME LOOP & ANIMATION
    // =========================================================================

    animate() {
        requestAnimationFrame(() => this.animate());

        const now = performance.now();
        const delta = Math.min((now - this.lastFrameTime) / 1000, 0.1);
        this.lastFrameTime = now;

        // 1. WASD Movement (Player movement is purely via WASD keys)
        if (this.viewMode === 'FPS') {
            const currentSpeed = this.keys.sprint ? this.sprintSpeed : this.moveSpeed;
            const forward = new THREE.Vector3(-Math.sin(this.cameraYaw), 0, -Math.cos(this.cameraYaw));
            const right = new THREE.Vector3(Math.cos(this.cameraYaw), 0, -Math.sin(this.cameraYaw));

            let moveDir = new THREE.Vector3();
            if (this.keys.forward) moveDir.add(forward);
            if (this.keys.backward) moveDir.sub(forward);
            if (this.keys.left) moveDir.sub(right);
            if (this.keys.right) moveDir.add(right);

            if (moveDir.lengthSq() > 0) {
                moveDir.normalize();
                this.playerPos.addScaledVector(moveDir, currentSpeed * delta);
                this.playerPos.x = Math.max(-27, Math.min(27, this.playerPos.x));
                this.playerPos.z = Math.max(-27, Math.min(27, this.playerPos.z));
            }

            this.updateCameraTransform();
        } else {
            this.orbitControls.update();
        }

        this.renderer.render(this.scene, this.camera);
    }

    showToast(msg, duration = 1500) {
        const toast = document.getElementById('confirmation-toast');
        if (toast) {
            toast.textContent = msg;
            toast.classList.add('show');
            clearTimeout(this._toastTimeout);
            this._toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, duration);
        }
    }
}

// Start Game System
const game = new FurnitureGameSystem();
